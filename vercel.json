{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix client install",
  "buildCommand": "mkdir -p client/public && cp client/src/data/rentals.json client/public/rentals.json && npm --prefix client run build",
  "outputDirectory": "client/dist",
  "build": {
    "env": {
      "VITE_BASE_PATH": "/projects/hdb-rental-prices-sg"
    }
  },
  "rewrites": [
    { "source": "/api/rentals", "destination": "/rentals.json" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/rentals.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}

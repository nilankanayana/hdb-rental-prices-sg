# HDB Rental Prices Dashboard (Singapore) — Environment Template
# Copy this file to `.env` and adjust for local development.
# Do NOT commit `.env` to version control.

# ---------------------------------------------------------------------
# Data source
# ---------------------------------------------------------------------
# Built from the static data.gov.sg dataset "Renting Out of Flats from
# Jan 2021" (owner-declared approved HDB rentals). Place the CSV at the
# repo root and run `npm run build:data` to aggregate it into
# client/src/data/rentals.json. No API key is required.
#
# Optional: a OneMap token (free, from onemap.gov.sg) enables the geocoding
# step (`npm run geocode`) that resolves each block+street to lat/lng for
# block-level map pins. Results are cached on disk, so the token is only
# needed when geocoding new addresses. The browser never calls OneMap.
ONEMAP_TOKEN=

# ---------------------------------------------------------------------
# Proxy server (local dev only — ignored on static hosts)
# ---------------------------------------------------------------------
SERVER_HOST=127.0.0.1
SERVER_PORT=3004

# ---------------------------------------------------------------------
# Client dev server (Vite) — local dev only
# ---------------------------------------------------------------------
CLIENT_HOST=127.0.0.1
CLIENT_PORT=8504
# Comma-separated extra hostnames/IPs allowed to load the dev server.
# CLIENT_ALLOWED_HOSTS=
